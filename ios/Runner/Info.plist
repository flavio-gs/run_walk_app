<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Empire Of The Run</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>run_walk_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-7215014769653180~1577870814</string>
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>

	<!-- ========================= -->
	<!-- LOCALIZAÇÃO -->
	<!-- ========================= -->

	<key>NSLocationWhenInUseUsageDescription</key>
	<string>O aplicativo utiliza sua localização para registrar corridas, caminhadas e desafios territoriais.</string>

	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>O aplicativo utiliza sua localização em segundo plano para continuar registrando atividades físicas durante a corrida.</string>

	<key>NSLocationAlwaysUsageDescription</key>
	<string>O aplicativo utiliza sua localização para rastrear atividades físicas e mapas.</string>

	<key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
    <!-- Esta é a mais importante para evitar o pulo no iOS -->
    <key>NSLocationTemporaryUsageDescriptionDictionary</key>
    <dict>
      <key>PreciseLocation</key>
      <string>O aplicativo precisa de localização precisa para rastrear sua corrida corretamente.</string>
    </dict>

	<!-- ========================= -->
	<!-- NOTIFICAÇÕES -->
	<!-- ========================= -->

	<key>NSUserNotificationsUsageDescription</key>
	<string>O aplicativo envia notificações sobre corridas, interações sociais e desafios.</string>

	<!-- ========================= -->
	<!-- TRACKING -->
	<!-- ========================= -->

	<key>NSUserTrackingUsageDescription</key>
	<string>O aplicativo pode utilizar identificadores para melhorar anúncios e experiência do usuário.</string>

    <!-- ========================= -->
	<!-- MOVIMENTO / FITNESS -->
	<!-- ========================= -->

	<key>NSMotionUsageDescription</key>
	<string>O aplicativo utiliza dados de movimento para melhorar o rastreamento das atividades físicas.</string>

	<!-- ========================= -->
	<!-- MICROFONE (caso use áudio futuramente) -->
	<!-- ========================= -->

	<key>NSMicrophoneUsageDescription</key>
	<string>O aplicativo pode utilizar o microfone para funcionalidades relacionadas à atividade física.</string>

	<!-- ========================= -->
	<!-- BACKGROUND MODES -->
	<!-- ========================= -->

	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>

	<!-- ========================= -->
	<!-- APP TRANSPORT SECURITY -->
	<!-- ========================= -->

	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>

	<!-- ========================= -->
	<!-- FIREBASE -->
	<!-- ========================= -->

	<key>FirebaseAppDelegateProxyEnabled</key>
	<true/>
</dict>
</plist>
